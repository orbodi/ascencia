APP_NAME=Geminia Schedule POC
APP_ENV=development
DEMO_MODE=true
API_TOKEN=change-me
AUTONOMOUS_MODE_ENABLED=false
AUTONOMOUS_PUBLISH_ENABLED=false
AUTONOMOUS_TARGET_WEEK_OFFSET=1
AUTONOMOUS_POLL_SECONDS=300
AUTONOMOUS_REMINDER_HOURS=24
AUTONOMOUS_MAX_REMINDERS=3
AUTONOMOUS_CHANNELS=email,whatsapp

# En local (uvicorn hors Docker) : localhost
# Sous Docker Compose, l'URL est forcée vers l'hôte "db" dans docker-compose.yml
DATABASE_URL=postgresql+asyncpg://geminia:geminia@localhost:5432/geminia

GEMINI_API_KEY=votre_cle_api_ici
GEMINI_MODEL=gemini-3.5-flash-lite

WHATSAPP_MOCK=true
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=geminia-verify
WHATSAPP_APP_SECRET=
WHATSAPP_PRESENCE_TEMPLATE_NAME=
PUBLIC_BASE_URL=http://localhost:8000
PRESENCE_RESPONSE_HOURS=48
MAX_GROUP_DAILY_MINUTES=480
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# E-mail / formulaire (laisser EMAIL_MOCK=true pour les essais sans envoi réel)
EMAIL_MOCK=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
AVAILABILITY_FORM_URL=

# Listes JSON (numero = indicatif pays sans +)
WHATSAPP_ADMINS=[{"nom":"Admin","prenom":"Démo","numero":"22800000000","role":"admin"}]
WHATSAPP_TEACHERS=[{"nom":"Mensah (Démo)","prenom":"Ama","numero":"22800000001","role":"teacher"}]

UNIVERSITY_NAME=Ascencia Keyce Togo
SEMESTER_LABEL=Semestre 1 — 2026
REMINDER_DAYS_AHEAD=3

# Back-office JWT / compte seed
JWT_SECRET=change-me-jwt-secret-geminia
JWT_EXPIRE_HOURS=8
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@geminia.local
