APP_NAME=Geminia Schedule POC
APP_ENV=development
API_TOKEN=change-me

# En local (uvicorn hors Docker) : localhost
# Sous Docker Compose, l'URL est forcée vers l'hôte "db" dans docker-compose.yml
DATABASE_URL=postgresql+asyncpg://geminia:geminia@localhost:5432/geminia

GEMINI_API_KEY=votre_cle_api_ici
GEMINI_MODEL=gemini-3.5-flash-lite

WHATSAPP_MOCK=true
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=geminia-verify
WHATSAPP_APP_SECRET=

# Listes JSON (numero = indicatif pays sans +)
WHATSAPP_ADMINS=[{"nom":"Admin","prenom":"Demo","numero":"33600000000","role":"admin"}]
WHATSAPP_TEACHERS=[{"nom":"Martin","prenom":"Alice","numero":"33610000001","role":"teacher"},{"nom":"Dupont","prenom":"Bruno","numero":"33610000002","role":"teacher"},{"nom":"Bernard","prenom":"Chloé","numero":"33610000003","role":"teacher"},{"nom":"Petit","prenom":"David","numero":"33610000004","role":"teacher"},{"nom":"Robert","prenom":"Emma","numero":"33610000005","role":"teacher"}]

UNIVERSITY_NAME=Université Démo
SEMESTER_LABEL=Semestre 1 — 2026
REMINDER_DAYS_AHEAD=3

# Back-office JWT / compte seed
JWT_SECRET=change-me-jwt-secret-geminia
JWT_EXPIRE_HOURS=8
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@geminia.local
